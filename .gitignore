.idea/
.claude/settings.local.json
__pycache__/

# Per-session worktrees (this repo uses `.claude/worktrees/` for isolated sessions).
# Not release surface, never committed. `.claude/agents/*.md` stays tracked — that's
# the deliberate workflow "Agent crew" CLAUDE.md documents, not clutter.
/.claude/worktrees/

# Build output. Both paths are root-anchored: `bin/forge` is the committed shim, not a
# binary, and an unanchored `forge` would swallow it.
/forge
/dist/

# macOS Finder metadata.
.DS_Store
